<?php

/**
 * @file
 * Install functions for the Cucumber User Role Developer module.
 */

use Drupal\Core\Recipe\Recipe;
use Drupal\Core\Recipe\RecipeRunner;
use Drupal\cucumber_user_roles\UserRoleConfig;
use Drupal\cucumber_user_roles\UserRolePermissions;
use Drupal\cucumber_user_roles\UserRoleRedirect;

/**
 * Implements hook_install().
 */
function cucumber_user_role_developer_install($is_syncing) {

  // When the module is installed on its own, apply its default recipe. When
  // the default recipe installs the module, the recipe is already applied.
  if (!$is_syncing) {
    RecipeRunner::processRecipe(Recipe::createFromDirectory(__DIR__ . '/recipes/default'));
  }

  // The login / logout redirect paths are deliberately not set by the recipe
  // above: they live in "user_redirect.settings", a config object that the
  // contributed User Redirect module ships without a config schema, which
  // makes it unusable from a config action on a site with assertions enabled.
  // Setting them is idempotent, so it runs on both install paths.
  // @see \Drupal\cucumber_user_roles\UserRoleRedirect
  UserRoleRedirect::set('developer', '/webdashboard/developer_dashboard', '/user/login');

}

/**
 * Implements hook_uninstall().
 */
function cucumber_user_role_developer_uninstall($is_syncing) {

  UserRoleRedirect::remove('developer');

  // The role and its dashboard go with the module: they depend on it. A
  // configuration import brings its own settings.
  if (!$is_syncing) {
    UserRoleConfig::turnOff('developer');
  }

}

/**
 * Implements hook_update_dependencies().
 */
function cucumber_user_role_developer_update_dependencies() {
  // The way back to Draft is a step Cucumber Core adds to the workflow.
  $dependencies['cucumber_user_role_developer'][12001] = [
    'cucumber_core' => 12002,
  ];

  return $dependencies;
}

/**
 * Let the Developer role write features and take its steps of the workflow.
 */
function cucumber_user_role_developer_update_12001() {
  $granted = UserRolePermissions::grantFromRecipe('developer', __DIR__ . '/recipes/default');

  return \Drupal::translation()->formatPlural(
    count($granted),
    'The Developer role got one permission.',
    'The Developer role got @count permissions.',
  );
}

/**
 * Let the Admin role view the Developer dashboard.
 */
function cucumber_user_role_developer_update_12002() {
  // The recipe granted a permission of the Dashboards module, which Drupal
  // dropped: the dashboards of the roles are Web Dashboard ones.
  $granted = UserRolePermissions::grantFromRecipe('admin', __DIR__ . '/recipes/default');

  return $granted
    ? t('The Admin role may view the Developer dashboard.')
    : t('The Admin role was left as it is.');
}

/**
 * Remove the Developer role and its dashboard when the module is uninstalled.
 */
function cucumber_user_role_developer_update_12003() {
  // Without it the role and its dashboard stay behind, and the module cannot
  // be installed again.
  $changed = UserRoleConfig::enforceModule('developer');

  return $changed
    ? t('The Developer role and its dashboard now depend on their module.')
    : t('The Developer role and its dashboard were left as they are.');
}
