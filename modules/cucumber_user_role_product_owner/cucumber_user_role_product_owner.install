<?php

/**
 * @file
 * Install functions for the Cucumber User Role Product Owner module.
 */

use Drupal\Core\Recipe\Recipe;
use Drupal\Core\Recipe\RecipeRunner;
use Drupal\cucumber_user_roles\UserRolePermissions;
use Drupal\cucumber_user_roles\UserRoleRedirect;

/**
 * Implements hook_install().
 */
function cucumber_user_role_product_owner_install($is_syncing) {

  // When the module is installed on its own, apply its default recipe. When
  // the default recipe installs the module, the recipe is already applied.
  if (!$is_syncing) {
    RecipeRunner::processRecipe(Recipe::createFromDirectory(__DIR__ . '/recipes/default'));
  }

  // The login / logout redirect paths are deliberately not set by the recipe
  // above: they live in "user_redirect.settings", a config object that the
  // contributed User Redirect module ships without a config schema, which
  // makes it unusable from a config action on a site with assertions enabled.
  // Setting them is idempotent, so it runs on both install paths.
  // @see \Drupal\cucumber_user_roles\UserRoleRedirect
  UserRoleRedirect::set('product_owner', '/webdashboard/product_owner_dashboard', '/user/login');

}

/**
 * Implements hook_uninstall().
 */
function cucumber_user_role_product_owner_uninstall() {

  UserRoleRedirect::remove('product_owner');

}

/**
 * Implements hook_update_dependencies().
 */
function cucumber_user_role_product_owner_update_dependencies() {
  // The way back to Draft is a step Cucumber Core adds to the workflow.
  $dependencies['cucumber_user_role_product_owner'][12001] = [
    'cucumber_core' => 12002,
  ];

  return $dependencies;
}

/**
 * Let the Product Owner role write features and take its steps of the workflow.
 */
function cucumber_user_role_product_owner_update_12001() {
  $granted = UserRolePermissions::grantFromRecipe('product_owner', __DIR__ . '/recipes/default');

  return \Drupal::translation()->formatPlural(
    count($granted),
    'The Product Owner role got one permission.',
    'The Product Owner role got @count permissions.',
  );
}
